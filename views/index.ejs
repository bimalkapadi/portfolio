<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <meta
    name="description"
    content="<%= profile.name %> — <%= profile.title %> specializing in <%= profile.specialty %>."
  >

  <title><%= profile.name %> — <%= profile.title %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <!-- Background -->
  <div class="noise"></div>
  <div class="bg-grid"></div>

  <!-- ================= NAVBAR ================= -->
  <nav class="nav">
    <div class="container nav-inner">

      <a class="brand" href="#home" aria-label="Home">
        <span class="brand-mark">BK</span>
        <span>Bimal Kapadi</span>
      </a>

      <button
        class="menu-toggle"
        id="menuToggle"
        aria-label="Toggle navigation"
      >
        ☰
      </button>

      <div class="nav-links" id="navLinks">
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#experience">Experience</a>
        <a href="#education">Education</a>
        <a href="#skills">Skills</a>
        <a href="#contact">Contact</a>
      </div>

    </div>
  </nav>


  <main>

    <!-- ================= HERO ================= -->
    <section class="hero" id="home">

      <div class="hero-lines"></div>

      <div class="container hero-grid">

        <!-- HERO TEXT -->
        <div class="hero-copy reveal">

          <div class="eyebrow">
            <span class="pulse"></span>
            CIVIL / STRUCTURAL ENGINEERING
          </div>

          <h1>
            <%= profile.name.split(" ")[0] %>
            <br>
            <span>
              <%= profile.name.split(" ").slice(1).join(" ") %>
            </span>
          </h1>

          <p class="hero-title">
            MSc Construction Engineering Management
          </p>

          <p class="hero-subtitle">
            University of East London
          </p>

          <p class="hero-text">
            <%= profile.tagline %>
          </p>

          <div class="hero-actions">

            <a href="#education" class="btn btn-primary">
              View Education
              <span>↗</span>
            </a>

            <a href="#contact" class="btn btn-ghost">
              Get in Touch
            </a>

          </div>

          <div class="quick-info">

            <span>
              📍 <%= profile.location %>
            </span>

            <span>
              ✉ <%= profile.email %>
            </span>

          </div>

        </div>


        <!-- HERO IMAGE -->
        <div class="hero-visual reveal">

          <div class="image-frame">

            <div class="image-glow"></div>

            <!-- Put your photo at:
                 public/images/bimal.jpg
            -->

            <img
              src="/images/bimal.jpg"
              alt="<%= profile.name %>"
              class="profile-image"
            >

            <div class="image-overlay"></div>

            <div class="image-corner corner-tl"></div>
            <div class="image-corner corner-tr"></div>
            <div class="image-corner corner-bl"></div>
            <div class="image-corner corner-br"></div>

            <div class="image-label">
              <span>ENGINEERING PROFILE</span>
              <strong>BK / 01</strong>
            </div>

          </div>


          <!-- Blueprint decoration -->
          <div class="blueprint-card">

            <div class="blueprint-grid"></div>

            <div class="blueprint-building">
              <div class="building-line line-1"></div>
              <div class="building-line line-2"></div>
              <div class="building-line line-3"></div>
              <div class="building-line line-4"></div>
              <div class="building-line line-5"></div>
            </div>

            <span class="blueprint-text">
              STRUCTURAL / 01
            </span>

            <span class="blueprint-text second">
              CONSTRUCTION
            </span>

          </div>

        </div>

      </div>

    </section>


    <!-- ================= ABOUT ================= -->
    <section id="about" class="section">

      <div class="container">

        <div class="section-head reveal">

          <div class="eyebrow">
            01 — PROFILE
          </div>

          <h2>
            Engineering with
            <br>
            <em>purpose.</em>
          </h2>

          <p>
            Technical knowledge supported by practical engineering
            experience, project coordination and continuous professional
            development.
          </p>

        </div>


        <div class="about-grid">

          <div class="about-copy reveal">

            <% about.forEach((paragraph) => { %>

              <p>
                <%= paragraph %>
              </p>

            <% }) %>

          </div>


          <div class="stats reveal">

            <div class="stat">

              <strong>MSc</strong>

              <span>
                Construction Engineering
                <br>
                Management
              </span>

            </div>


            <div class="stat">

              <strong>2026–28</strong>

              <span>
                Master's
                <br>
                Programme
              </span>

            </div>


            <div class="stat">

              <strong>UEL</strong>

              <span>
                University of
                <br>
                East London
              </span>

            </div>


            <div class="stat">

              <strong>4</strong>

              <span>
                Languages
                <br>
                Spoken
              </span>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- ================= EXPERIENCE ================= -->
    <section id="experience" class="section dark-section">

      <div class="container">

        <div class="section-head reveal">

          <div class="eyebrow">
            02 — EXPERIENCE
          </div>

          <h2>
            Professional
            <br>
            <em>journey.</em>
          </h2>

          <p>
            Professional experience across civil engineering,
            construction and project environments.
          </p>

        </div>


        <div class="timeline">

          <% experience.forEach((job, index) => { %>

            <article class="timeline-item reveal">

              <div class="timeline-marker">
                <%= job.icon || "◆" %>
              </div>

              <div class="timeline-line"></div>

              <div class="timeline-card">

                <% if (job.current) { %>

                  <span class="current-badge">
                    ● CURRENT
                  </span>

                <% } %>

                <div class="job-index">
                  <%= String(index + 1).padStart(2, "0") %>
                </div>

                <h3>
                  <%= job.role %>
                </h3>

                <h4>
                  <%= job.company %>

                  <% if (job.project) { %>

                    <span>
                      · <%= job.project %>
                    </span>

                  <% } %>

                </h4>

                <div class="job-date">
                  <%= job.date %>
                </div>

                <p>
                  <%= job.desc %>
                </p>

                <div class="location">
                  📍 <%= job.location %>
                </div>

              </div>

            </article>

          <% }) %>

        </div>

      </div>

    </section>


    <!-- ================= EDUCATION ================= -->
    <section id="education" class="section">

      <div class="container">

        <div class="section-head reveal">

          <div class="eyebrow">
            03 — EDUCATION
          </div>

          <h2>
            Academic
            <br>
            <em>foundation.</em>
          </h2>

          <p>
            Academic qualifications and professional development
            in construction and civil engineering.
          </p>

        </div>


        <div class="education-grid">

          <!-- NEW MSc EDUCATION -->
          <article class="education-card education-feature reveal">

            <div class="edu-top">

              <span class="edu-icon">
                🎓
              </span>

              <span class="edu-period">
                2026 — 2028
              </span>

            </div>

            <div class="edu-number">
              01
            </div>

            <h3>
              MSc Construction Engineering Management
            </h3>

            <h4>
              With Industrial Placement
            </h4>

            <p class="edu-school">

              University of East London

              <br>

              <span>
                Docklands Campus,
                University Way,
                London E16 2RD,
                United Kingdom
              </span>

            </p>

            <div class="edu-bottom">

              <strong>
                MSc
              </strong>

              <small>
                Construction Engineering Management
              </small>

            </div>

          </article>


          <!-- EXISTING EDUCATION -->
          <% education.forEach((edu, index) => { %>

            <article class="education-card reveal">

              <div class="edu-top">

                <span class="edu-icon">
                  <%= edu.icon || "🎓" %>
                </span>

                <span class="edu-period">
                  <%= edu.period %>
                </span>

              </div>

              <div class="edu-number">
                <%= String(index + 2).padStart(2, "0") %>
              </div>

              <h3>
                <%= edu.degree %>
              </h3>

              <% if (edu.field) { %>

                <h4>
                  <%= edu.field %>
                </h4>

              <% } %>

              <p class="edu-school">

                <%= edu.school %>

                <br>

                <span>
                  <%= edu.location %>
                </span>

              </p>

              <div class="edu-bottom">

                <% if (edu.grade) { %>

                  <strong>
                    <%= edu.grade %>
                  </strong>

                <% } %>

                <% if (edu.certificate) { %>

                  <small>
                    <%= edu.certificate %>
                  </small>

                <% } %>

              </div>

            </article>

          <% }) %>

        </div>

      </div>

    </section>


    <!-- ================= SKILLS ================= -->
    <section id="skills" class="section skills-section">

      <div class="container">

        <div class="section-head reveal">

          <div class="eyebrow">
            04 — CAPABILITIES
          </div>

          <h2>
            Skills &
            <br>
            <em>strengths.</em>
          </h2>

          <p>
            Core engineering, management and professional skills.
          </p>

        </div>


        <div class="skills-layout">

          <div class="skills-grid">

            <% skills.forEach((skill, index) => { %>

              <div class="skill-card reveal">

                <span class="skill-number">
                  <%= String(index + 1).padStart(2, "0") %>
                </span>

                <span>
                  <%= skill %>
                </span>

                <b>
                  ↗
                </b>

              </div>

            <% }) %>

          </div>


          <div class="traits-card reveal">

            <div class="traits-label">
              PROFESSIONAL TRAITS
            </div>

            <% traits.forEach((trait) => { %>

              <div class="trait">

                <span>
                  ✓
                </span>

                <p>
                  <%= trait %>
                </p>

              </div>

            <% }) %>

          </div>

        </div>


        <!-- LANGUAGES -->
        <div class="languages reveal">

          <span>
            Languages
          </span>

          <% profile.languages.forEach((language) => { %>

            <b>
              <%= language %>
            </b>

          <% }) %>

        </div>

      </div>

    </section>


    <!-- ================= CONTACT ================= -->
    <section id="contact" class="section contact-section">

      <div class="container contact-grid">

        <div class="reveal">

          <div class="eyebrow">
            05 — CONTACT
          </div>

          <h2>
            Let's build
            <br>
            <em>something solid.</em>
          </h2>

          <p>
            Available for professional opportunities,
            engineering projects, construction management
            and meaningful collaboration.
          </p>

        </div>


        <div class="contact-panel reveal">

          <a
            href="mailto:<%= profile.email %>"
            class="contact-row"
          >

            <span>✉</span>

            <div>

              <small>
                EMAIL
              </small>

              <strong>
                <%= profile.email %>
              </strong>

            </div>

            <b>↗</b>

          </a>


          <a
            href="tel:<%= profile.phoneRaw %>"
            class="contact-row"
          >

            <span>☎</span>

            <div>

              <small>
                PHONE
              </small>

              <strong>
                <%= profile.phone %>
              </strong>

            </div>

            <b>↗</b>

          </a>


          <div class="contact-row">

            <span>⌖</span>

            <div>

              <small>
                LOCATION
              </small>

              <strong>
                <%= profile.location %>
              </strong>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- ================= REFERENCE ================= -->
    <section class="section reference-section">

      <div class="container">

        <div class="reference-card reveal">

          <div>

            <div class="eyebrow">
              PROFESSIONAL REFERENCE
            </div>

            <h3>
              <%= reference.name %>
            </h3>

            <p>
              <%= reference.designation %>
              <br>
              <%= reference.organization %>
            </p>

          </div>


          <div class="reference-contact">

            <a href="tel:<%= reference.phone %>">
              <%= reference.phone %>
            </a>

            <a href="mailto:<%= reference.email %>">
              <%= reference.email %>
            </a>

            <span>
              <%= reference.website %>
            </span>

          </div>

        </div>

      </div>

    </section>

  </main>


  <!-- ================= FOOTER ================= -->
  <footer>

    <div class="container footer-inner">

      <span>
        © <%= year %> <%= profile.name %>
      </span>

      <span>
        Built with Node.js · Express · EJS
      </span>

      <a href="#home">
        Back to top ↑
      </a>

    </div>

  </footer>


  <script src="/js/script.js"></script>

</body>
</html>
